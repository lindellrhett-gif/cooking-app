# Supabase project settings -> API
# Safe to ship in the app bundle: RLS is what enforces access, not this key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOT used by the app. Only for scripts/seed.mjs, which runs on your machine.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NEVER put this in .env for the app. Set it as an Edge Function secret:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
